# Routine, non-secret configuration only.
# Gemini and LinkedIn credentials are NEVER stored here — they are entered
# through the Settings page in the running app and encrypted at rest.
#
# Copy this file to backend/.env and adjust if needed. All values below
# are optional; sensible defaults are used if omitted.

# LTP_HOST=127.0.0.1
# LTP_PORT=8000
# LTP_DATABASE_URL=sqlite:///./instance/app.db
# LTP_WORKER_POLL_INTERVAL_SECONDS=2.0
# LTP_JOB_LEASE_SECONDS=120
# LTP_JOB_MAX_ATTEMPTS=3
# LTP_DEFAULT_TIMEZONE=Asia/Kolkata
# LTP_DEMO_MODE=false

# Optional: force the credential-encryption key instead of using the OS
# keyring / local instance/encryption.key fallback. Must be a valid
# Fernet key (32 url-safe base64 bytes). Leave unset in normal use.
# LTP_ENCRYPTION_KEY=

# Optional: override the signed-session-cookie secret (a random string
# is generated and persisted automatically if unset).
# LTP_SESSION_SECRET=
